# Firebase do Stopix (salas do modo amigos): Realtime Database + login anônimo.
# Console do Firebase → Configurações do projeto → seu app da Web.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_DATABASE_URL=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Emulador local (bun run emulators): NEXT_PUBLIC_FIREBASE_EMULATOR=1 com
# DATABASE_URL="http://127.0.0.1:9000?ns=demo-stopix" e PROJECT_ID="demo-stopix".
# NEXT_PUBLIC_FIREBASE_EMULATOR="1"

# Realtime Database do Neon Live Labs (valores públicos, os mesmos NEXT_PUBLIC_FIREBASE_*
# do site do Neon e do Sentrix). O overlay lê channels/{código}/events e /stats.
NEXT_PUBLIC_NEON_FIREBASE_DATABASE_URL=""
NEXT_PUBLIC_NEON_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_NEON_FIREBASE_API_KEY=""

# Endereço público do site (links do painel).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
