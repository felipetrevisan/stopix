{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_NEON_FIREBASE_DATABASE_URL",
        "NEXT_PUBLIC_NEON_FIREBASE_PROJECT_ID",
        "NEXT_PUBLIC_NEON_FIREBASE_API_KEY",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
